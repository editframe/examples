# =============================================================================
# Editframe Allbirds — Tree Runner NZ Demo — Environment Variables
# =============================================================================
# NONE REQUIRED. This demo renders fully local — Editframe runs against the
# React composition; the music bed and well footage are native <Audio>/<Video>
# elements on the timeline (no post-mux step).
# Copy this file to `.env` only if you extend the template with the optional
# integrations below.
# =============================================================================

# Editframe Cloud (only if you push renders to the Editframe cloud instead of
# rendering locally with `npm run render`). Get yours at https://editframe.com/dashboard
# EDITFRAME_API_KEY=

# fal.ai (only if you regenerate product/lifestyle imagery at build time — not
# used by the default pipeline, assets are already baked in). https://fal.ai/dashboard/keys
# FAL_KEY=
