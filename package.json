{
  "name": "editframe-examples",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A single Editframe workbench project for browsing, previewing, and rendering every example video composition in this repo.",
  "scripts": {
    "start": "editframe preview",
    "render": "editframe render",
    "render:allbirds-tree-runner-demo": "EF_RENDER_PROJECT=allbirds-tree-runner-demo editframe render --data '{\"project\": \"allbirds-tree-runner-demo\"}' -o allbirds-tree-runner-demo/output/demo.mp4",
    "render:claude-code-demo": "EF_RENDER_PROJECT=claude-code-demo editframe render --data '{\"project\": \"claude-code-demo\"}' -o claude-code-demo/output/demo.mp4",
    "render:claude-code-financial-demo": "EF_RENDER_PROJECT=claude-code-financial-demo editframe render --data '{\"project\": \"claude-code-financial-demo\"}' -o claude-code-financial-demo/output/demo.mp4",
    "render:claude-office-demo": "EF_RENDER_PROJECT=claude-office-demo editframe render --data '{\"project\": \"claude-office-demo\"}' -o claude-office-demo/output/demo.mp4",
    "render:claude-opus48-demo": "EF_RENDER_PROJECT=claude-opus48-demo editframe render --data '{\"project\": \"claude-opus48-demo\"}' -o claude-opus48-demo/output/demo.mp4",
    "render:claude-security-demo": "EF_RENDER_PROJECT=claude-security-demo editframe render --data '{\"project\": \"claude-security-demo\"}' -o claude-security-demo/output/demo.mp4",
    "render:clerk-cli-demo": "EF_RENDER_PROJECT=clerk-cli-demo editframe render --data '{\"project\": \"clerk-cli-demo\"}' -o clerk-cli-demo/output/demo.mp4",
    "render:codex-demo": "EF_RENDER_PROJECT=codex-demo editframe render --data '{\"project\": \"codex-demo\"}' -o codex-demo/output/demo.mp4",
    "render:cursor-cloud-agents-demo": "EF_RENDER_PROJECT=cursor-cloud-agents-demo editframe render --data '{\"project\": \"cursor-cloud-agents-demo\"}' -o cursor-cloud-agents-demo/output/demo.mp4",
    "render:cursor-jira-demo": "EF_RENDER_PROJECT=cursor-jira-demo editframe render --data '{\"project\": \"cursor-jira-demo\"}' -o cursor-jira-demo/output/demo.mp4",
    "render:cursor-sdk-demo": "EF_RENDER_PROJECT=cursor-sdk-demo editframe render --data '{\"project\": \"cursor-sdk-demo\"}' -o cursor-sdk-demo/output/demo.mp4",
    "render:fal-ai-demo": "EF_RENDER_PROJECT=fal-ai-demo editframe render --data '{\"project\": \"fal-ai-demo\"}' -o fal-ai-demo/output/demo.mp4",
    "render:fashionnova-the-edit-demo": "EF_RENDER_PROJECT=fashionnova-the-edit-demo editframe render --data '{\"project\": \"fashionnova-the-edit-demo\"}' -o fashionnova-the-edit-demo/output/demo.mp4",
    "render:figma-agent-demo": "EF_RENDER_PROJECT=figma-agent-demo editframe render --data '{\"project\": \"figma-agent-demo\"}' -o figma-agent-demo/output/demo.mp4",
    "render:gymshark-geo-seamless-demo": "EF_RENDER_PROJECT=gymshark-geo-seamless-demo editframe render --data '{\"project\": \"gymshark-geo-seamless-demo\"}' -o gymshark-geo-seamless-demo/output/demo-silent.mp4",
    "render:linear-agents-demo": "EF_RENDER_PROJECT=linear-agents-demo editframe render --data '{\"project\": \"linear-agents-demo\"}' -o linear-agents-demo/output/demo.mp4",
    "render:olipop-demo": "EF_RENDER_PROJECT=olipop-demo editframe render --data '{\"project\": \"olipop-demo\"}' -o olipop-demo/output/demo-silent.mp4 && bash olipop-demo/composite-well.sh",
    "render:rhode-demo": "EF_RENDER_PROJECT=rhode-demo editframe render --data '{\"project\": \"rhode-demo\"}' -o rhode-demo/output/demo.mp4",
    "render:vercel-deploy-demo": "EF_RENDER_PROJECT=vercel-deploy-demo editframe render --data '{\"project\": \"vercel-deploy-demo\"}' -o vercel-deploy-demo/output/demo.mp4",
    "render:vercel-knowledge-base-demo": "EF_RENDER_PROJECT=vercel-knowledge-base-demo editframe render --data '{\"project\": \"vercel-knowledge-base-demo\"}' -o vercel-knowledge-base-demo/output/demo.mp4"
  },
  "dependencies": {
    "@editframe/cli": "0.59.27",
    "@editframe/elements": "0.59.27",
    "@editframe/react": "0.59.27",
    "@editframe/vite-plugin": "0.59.27",
    "@fal-ai/client": "^1.10.1",
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "animejs": "^4.0.0",
    "gsap": "^3.13.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tailwindcss": "^4.0.0",
    "three": "^0.180.0",
    "vite": "^8.0.0",
    "vite-plugin-singlefile": "^2.3.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.180.0",
    "typescript": "^5.9.3"
  }
}
