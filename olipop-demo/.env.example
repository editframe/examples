# =============================================================================
# Editframe OLIPOP Demo — Environment Variables
# =============================================================================
# NONE REQUIRED. This demo renders fully local — Editframe runs against the
# React composition, the well video composite and audio mux are pure FFmpeg.
# Copy this file to `.env` only if you extend the template with the optional
# integrations below.
# =============================================================================

# Editframe Cloud (only if you push renders to the Editframe cloud instead of
# rendering locally with `npm run render`). Get yours at https://editframe.com/dashboard
# EDITFRAME_API_KEY=

# fal.ai (only if you regenerate AI poster frames / well clips at build time —
# not used by the default pipeline). https://fal.ai/dashboard/keys
# FAL_KEY=
