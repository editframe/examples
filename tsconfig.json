{
  "compilerOptions": {
    "target": "ES2020",
    "jsx": "react",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": false,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["shared/*"]
    }
  },
  "include": ["src", "*/src", "shared", "vite.config.ts"],
  "exclude": ["node_modules", "*/extras"]
}
