# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
.vite/
.vite-cache/
.turbo/

# Shared Editframe local asset cache (transcoded media, across all examples)
.editframe-cache/

# Per-asset Editframe transcode cache, written next to media files as
# src/assets/.cache/<hash>/*.track-1.mp4 + *.tracks.json — derived, regenerable
**/.cache/

# Render artifacts — each example's repo commits ONLY output/demo.mp4 (final, with audio)
*/output/*
!*/output/demo.mp4
output.mp4
frames/
_refframes/

# Finalize temp artifacts (regenerated by composite-well.sh / add-audio.sh)
_tmp_*.mp4
_mask_*.png

# Internal build / QA artifacts — not part of any published example
.claude/
.trace-frames/
# TRACE_MODE alignment frames extracted from reference-trace.mp4 (dev/debug
# scaffolding, regenerable — the trace-frames.ts code files stay tracked)
*/src/assets/trace/
*/src/assets/trace-frames/
# TRACE_MODE source recordings — dev/debug-only (TraceLayer), kept locally
*reference-trace.mp4
ref-frames/
refs/
debug-frames/
verify/
verify-frames/
verify-final/
scripts/
write-scenes.mjs
src.*-bak/
_check/
qa/
judgeqa/
myframes/
editframes-opus48-base/
cur_*.png
