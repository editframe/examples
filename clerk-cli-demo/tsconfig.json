{
  "compilerOptions": {
    "target": "ES2020",
    "jsx": "react",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": false
  },
  "exclude": ["extras", "node_modules"]
}
