# =============================================================================
# Editframe — Gymshark Geo Seamless Demo — Environment Variables
# =============================================================================
# Copy this file to `.env` if you extend the template. NONE ARE REQUIRED to
# render: Editframe runs fully local against the React composition, and the
# add-audio.sh finalize step is pure FFmpeg. The keys below are optional.
# =============================================================================

# Editframe Cloud (only needed if you push renders to the Editframe cloud
# instead of rendering locally with `npm run render`).
# Get yours at https://editframe.com/dashboard
# EDITFRAME_API_KEY=

# fal.ai (only needed if you regenerate the brand poster/video frames at build
# time. Not used by the default pipeline.)
# Get yours at https://fal.ai/dashboard/keys
# FAL_KEY=
