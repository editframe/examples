# =============================================================================
# Editframe Higgsfield MCP Demo — Environment Variables
# =============================================================================
# Copy this file to `.env` and fill in any keys you need.
# The base template does NOT require any env vars to render — Editframe runs
# fully local against the React composition. Keys below are optional, listed
# in case you extend the template.
# =============================================================================

# Editframe Cloud (only needed if you push renders to the Editframe cloud
# instead of rendering locally with `npm run render`).
# Get yours at https://editframe.com/dashboard
# EDITFRAME_API_KEY=

# fal.ai (only needed if you generate dynamic CTA images, end-card art, or
# AI-derived poster frames at build time. Not used by the default pipeline.)
# Get yours at https://fal.ai/dashboard/keys
# FAL_KEY=
