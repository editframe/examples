# =============================================================================
# Editframe — Fashion Nova "The Edit" Demo — Environment Variables
# =============================================================================
# NONE REQUIRED. The demo renders fully local against the React composition —
# `npm run render` needs no API keys. Copy this file to `.env` only if you
# extend the template with the optional integrations below.
# =============================================================================

# Editframe Cloud (only if you push renders to the Editframe cloud instead of
# rendering locally). Get yours at https://editframe.com/dashboard
# EDITFRAME_API_KEY=

# fal.ai (only if you generate dynamic art at build time — not used by default).
# Get yours at https://fal.ai/dashboard/keys
# FAL_KEY=
